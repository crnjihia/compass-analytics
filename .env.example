# ==============================================================================
# Compass Analytics - Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL 16)
# Direct connection for migrations/superuser administrative tasks
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/compass_analytics?sslmode=disable"
# Non-superuser application connection enforced with Row-Level Security (no BYPASSRLS)
DATABASE_URL="postgresql://compass_app:compass_secret@localhost:5432/compass_analytics?sslmode=disable"

# Redis Configuration (Redis 7)
REDIS_URL="redis://localhost:6379"

# Security & Encryption
# 32-byte hex-encoded key for AES-256-GCM field encryption of M-Pesa secrets
# Generated with: openssl rand -hex 32
AES_256_GCM_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Per-organization salt secret for HMAC-SHA256 MSISDN anonymization
MSISDN_SALT_SECRET="compass_super_secret_msisdn_salt_key_2026"

# Clerk Authentication & Multi-Tenancy
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
CLERK_SECRET_KEY="sk_test_placeholder"
CLERK_WEBHOOK_SECRET="whsec_placeholder"

# Ingest Service (Go)
INGEST_PORT=8080
INGEST_METRICS_PORT=9100

# Safaricom Daraja M-Pesa API (Sandbox defaults)
DARAJA_ENVIRONMENT="sandbox"
DARAJA_CONSUMER_KEY="sandbox_consumer_key"
DARAJA_CONSUMER_SECRET="sandbox_consumer_secret"
DARAJA_PASSKEY="bfb279f9aa9bdbaca158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c91"
DARAJA_SHORTCODE="174379"

# Prometheus / Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD="admin"
